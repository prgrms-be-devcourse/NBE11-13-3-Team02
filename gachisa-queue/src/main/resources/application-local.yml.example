# 이 파일을 application-local.yml 로 복사해서 각자 로컬에서 사용하세요.
# application-local.yml 자체는 .gitignore 에 등록되어 Git 에는 올라가지 않습니다.
#
# ./setup.sh 를 실행하면 아래 두 값이 core / 챗봇과 같은 값으로 자동 생성됩니다.
# 직접 채울 때 기준값은 다음과 같습니다.
#   jwt-secret     : gachisa-backend/src/main/resources/application-local.yml 의 jwt.secret
#   internal-token : 프로젝트 루트 .env.local 의 QUEUE_INTERNAL_TOKEN
#
# jwt-secret 이 core 와 한 글자라도 다르면 core 가 발급한 토큰을 queue 가 거부합니다.

queue:
  jwt-secret: change-this-to-a-64-byte-or-longer-random-string-for-hs512-algorithm-xxxxx
  internal-token: change-this-to-match-env-local-queue-internal-token
