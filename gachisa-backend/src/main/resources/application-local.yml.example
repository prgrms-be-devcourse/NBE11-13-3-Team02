# 이 파일을 application-local.yml 로 복사해서 각자 로컬에서 사용하세요.
# application-local.yml 자체는 .gitignore에 등록되어 Git에는 올라가지 않습니다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/gachisa?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: gachisa
    password: gachisa1234
    driver-class-name: com.mysql.cj.jdbc.Driver

  data:
    redis:
      host: localhost
      port: 6379

  jpa:
    hibernate:
      # create-drop + sql.init.mode: always → 앱 시작마다 스키마/시드 초기화
      # update + sql.init.mode: never → 기존 DB 유지 (이미 시드된 로컬 DB용)
      ddl-auto: create-drop
    defer-datasource-initialization: true
    show-sql: true

  sql:
    init:
      mode: always

jwt:
  secret: change-this-to-a-64-byte-or-longer-random-string-for-hs512-algorithm-xxxxx

# 카카오/네이버 개발자 콘솔에서 발급받은 값으로 채우세요. 비워두면 소셜 로그인만 동작 안 하고
# 나머지 기능은 정상 동작합니다 (OAUTH_PROVIDER_ERROR로 응답).
oauth:
  kakao:
    client-id: your-kakao-rest-api-key
    client-secret: your-kakao-client-secret
  naver:
    client-id: your-naver-client-id
    client-secret: your-naver-client-secret
