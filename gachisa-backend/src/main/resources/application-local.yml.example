# 이 파일을 application-local.yml 로 복사해서 각자 로컬에서 사용하세요.
# application-local.yml 자체는 .gitignore에 등록되어 Git에는 올라가지 않습니다.
#
# DB/JWT/OAuth/결제 시크릿은 이제 여기 두지 않습니다 — 전부 Infisical에서 관리합니다.
# application.yml의 환경변수 플레이스홀더에 기본값이 없어서, 반드시
# `infisical run --env=dev -- ./gradlew bootRun`으로 실행해야 합니다.
# (docs/infisical.md 참고)
#
# 여기 남은 건 로컬 개발 편의를 위한 설정뿐입니다.

spring:
  jpa:
    hibernate:
      # create-drop + sql.init.mode: always → 앱 시작마다 스키마/시드 초기화
      # update + sql.init.mode: never → 기존 DB 유지 (이미 시드된 로컬 DB용)
      ddl-auto: create-drop
    defer-datasource-initialization: true
    show-sql: true

  sql:
    init:
      mode: always
