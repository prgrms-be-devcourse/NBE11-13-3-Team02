# Toss Payments 클라이언트 키 (test_ck_... / live_ck_...) - 결제 페이지 동작에 필수
VITE_TOSS_CLIENT_KEY=

# 카카오 개발자 콘솔의 REST API 키 (client secret 아님 - 이건 공개돼도 되는 값)
# 카카오 콘솔에 리다이렉트 URI로 {origin}/oauth/kakao 을 등록해야 함
VITE_KAKAO_CLIENT_ID=

# 네이버 개발자 센터의 Client ID (Client Secret은 백엔드에만 필요, 프론트엔 불필요)
# 네이버 콘솔에 리다이렉트 URI로 {origin}/oauth/naver 을 등록해야 함
VITE_NAVER_CLIENT_ID=