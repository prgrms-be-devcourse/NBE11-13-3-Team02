# Spring의 application-local.yml에 있는 jwt.secret과 완전히 동일해야 한다.
# (HS512라 최소 64바이트 필요)
JWT_SECRET=change-this-secret-in-local-yml

SPRING_BASE_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:5173"]

# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-...
# low로 시작한다. 평가셋으로 도구 라우팅 정확도를 잰 뒤 medium/high 승급을 판단한다.
ANTHROPIC_EFFORT=low
