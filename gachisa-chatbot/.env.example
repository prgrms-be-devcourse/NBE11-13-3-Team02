# Spring의 application-local.yml에 있는 jwt.secret과 완전히 동일해야 한다.
# (HS512라 최소 64바이트 필요)
JWT_SECRET=change-this-secret-in-local-yml

SPRING_BASE_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:5173"]

# https://aistudio.google.com/apikey 에서 발급 (무료 티어)
GEMINI_API_KEY=...
# 기본 gemini-3.5-flash. 더 아끼려면 gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash
