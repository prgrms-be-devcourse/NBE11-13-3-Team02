{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "백엔드 수집 상태",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"gachisa-backend\"}",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API 요청률 (상태 코드별 · 15초)",
      "datasource": "prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"gachisa-backend\",uri!=\"/actuator/prometheus\"}[15s]))",
          "legendFormat": "{{status}}",
          "interval": "15s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API 4xx 오류율 (5분)",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "(100 * sum(rate(http_server_requests_seconds_count{job=\"gachisa-backend\",status=~\"4..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"gachisa-backend\"}[5m])), 1)) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API 5xx 오류율 (5분)",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "(100 * sum(rate(http_server_requests_seconds_count{job=\"gachisa-backend\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"gachisa-backend\"}[5m])), 1)) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API 응답시간 P95",
      "datasource": "prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"gachisa-backend\",uri!=\"/actuator/prometheus\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB 커넥션 풀 상태",
      "datasource": "prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"gachisa-backend\"}",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_pending{job=\"gachisa-backend\"}",
          "legendFormat": "pending",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_max{job=\"gachisa-backend\"}",
          "legendFormat": "max",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "결제 대기열 현재 상태",
      "datasource": "prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 11
      },
      "targets": [
        {
          "expr": "gachisa_payment_queue_waiting",
          "legendFormat": "waiting",
          "refId": "A"
        },
        {
          "expr": "gachisa_payment_queue_admitted",
          "legendFormat": "admitted",
          "refId": "B"
        },
        {
          "expr": "gachisa_payment_queue_confirming",
          "legendFormat": "confirming",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "대기열 배출 흐름 (15초): 완료 · 다음 입장",
      "datasource": "prometheus",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 11
      },
      "targets": [
        {
          "expr": "sum by (event) (increase(gachisa_payment_queue_events_total{event=~\"completed|admitted\"}[15s]))",
          "legendFormat": "{{event}}",
          "interval": "15s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "등록(enqueued), 입장 허용(admitted), 결제 확정 시작(confirmation_started), 완료(completed), 만료/재대기 이벤트를 비교합니다."
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "최근 k6 실행 결과: 시도 · 서버 도달 · 정상 응답 · 최종 거부 · 초기 재시도",
      "datasource": "prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "max_over_time(k6_queue_attempted_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))",
          "legendFormat": "시도",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "max_over_time(k6_queue_server_reached_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))",
          "legendFormat": "서버 도달",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "max_over_time(k6_queue_expected_success_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))",
          "legendFormat": "정상 응답",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "(max_over_time(k6_queue_connection_rejected_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))) or vector(0)",
          "legendFormat": "연결 거부",
          "instant": true,
          "refId": "D"
        },
        {
          "expr": "(max_over_time(k6_queue_connection_retries_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))) or vector(0)",
          "legendFormat": "초기 재시도",
          "instant": true,
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "서버 도달과 정상 응답이 시도 수에 못 미치면, 서버 수용 한계 또는 연결 문제가 있었음을 뜻합니다."
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "최근 k6 실행 정합성: 실제 상태 ↔ 기대 상태",
      "datasource": "prometheus",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "expr": "max_over_time(k6_queue_admitted_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))",
          "legendFormat": "실제 admitted",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "clamp_max(max_over_time(k6_queue_expected_success_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range])), 10)",
          "legendFormat": "기대 admitted",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "max_over_time(k6_queue_waiting_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))",
          "legendFormat": "실제 waiting",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "clamp_min((max_over_time(k6_queue_expected_success_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))) - 10, 0)",
          "legendFormat": "기대 waiting",
          "instant": true,
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "정상 응답을 받은 사용자 수를 기준으로, 실제 admitted/waiting 합계가 기대치와 일치하는지 확인합니다."
    },
    {
      "id": 11,
      "type": "stat",
      "title": "대기열 정합성 차이",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "abs((max_over_time(k6_queue_admitted_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))) + (max_over_time(k6_queue_waiting_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))) - (max_over_time(k6_queue_expected_success_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "정상 응답 수와 actual admitted + waiting의 절대 차이입니다. 0이면 대기열 상태가 테스트 결과와 일치합니다."
    },
    {
      "id": 12,
      "type": "stat",
      "title": "예상 밖 대기열 상태",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "expr": "(max_over_time(k6_queue_unexpected_state_total[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "ADMITTED 또는 WAITING 이외의 응답을 받은 사용자 수입니다. 0이어야 합니다."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "k6와 서버 응답시간 P95 비교",
      "datasource": "prometheus",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "expr": "max_over_time(k6_http_req_duration_p95{expected_response=\"true\"}[$__range]) and on (testid) topk(1, max_over_time(k6_queue_test_started_timestamp[$__range]))",
          "legendFormat": "k6 client p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"gachisa-backend\",uri=~\"/api/group-buys/.*/queue-token\"[$__rate_interval])))",
          "legendFormat": "server p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "k6 측정값과 백엔드 내부 처리시간을 비교해 네트워크/클라이언트 구간과 서버 처리 구간을 구분합니다."
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": [
    "gachisa",
    "k6",
    "load-test"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "같이사 | k6 부하 테스트",
  "uid": null,
  "version": 1
}
